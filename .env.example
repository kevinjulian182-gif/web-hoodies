# Base de datos (PostgreSQL / Supabase)
# DATABASE_URL: para la app en tiempo de ejecución. En Supabase usa el
# connection string del pooler en modo "Transaction" (puerto 6543).
DATABASE_URL="postgresql://user:password@localhost:5432/hoodies"
# DIRECT_URL: solo para `prisma db push`/migrate. En Supabase usa el modo
# "Session" (puerto 5432) del mismo pooler, o la conexión directa —
# el modo "Transaction" no soporta los advisory locks que Prisma necesita.
DIRECT_URL="postgresql://user:password@localhost:5432/hoodies"

# Autenticación
AUTH_SECRET="genera-un-secreto-largo-y-aleatorio"

# Cifra las credenciales guardadas por el Super Admin en SystemConfig
CONFIG_ENCRYPTION_KEY="genera-otro-secreto-de-32-bytes"

# Valores por defecto (opcionales): el Super Admin también puede configurarlos
# desde el panel /admin/settings, donde quedan cifrados en base de datos.
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
INTER_RAPIDISIMO_API_KEY=""
RESEND_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
