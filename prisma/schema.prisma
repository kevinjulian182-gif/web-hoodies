generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  WOMPI
  COD
  TRANSFER
  /// Fiado: the customer took it and pays later, in one or more abonos.
  CREDIT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  // Set when the account belongs to one of the store's partners.
  partner      Partner?
  createdAt    DateTime @default(now())
}

model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  brand               String
  // Garment type (hoodie, chaqueta, ...) — optional since products created
  // before this field existed have none yet; managed the same way as
  // brand, via the separate Category list.
  category            String?
  description         String
  materials           String?
  details             String?
  careInstructions    String?
  priceCents          Int
  compareAtPriceCents Int?
  costCents           Int?
  images              String[]
  colorImages         Json?
  // Per-product override of the color name -> swatch hex shown on cards
  // and the PDP. Falls back to the shared name-based guess (lib/colors.ts)
  // for any color not present here, so existing products need no backfill.
  colorHex            Json?
  // Optional size chart shown on the PDP: { columns, rows: { [size]: values[] }, note? }
  // (see src/lib/sizeChart.ts). Null for products that don't have one.
  sizeChart           Json?
  videos              String[]         @default([])
  sizes               String[]
  colors              String[]         @default([])
  // Cached sum of variants[].stock — kept in sync on every write that
  // touches variants (admin save, checkout decrement) so every existing
  // read of "total stock for this product" keeps working unchanged.
  stock               Int              @default(0)
  active              Boolean          @default(true)
  isPromo             Boolean          @default(false)
  orderItems          OrderItem[]
  reviews             Review[]
  variants            ProductVariant[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// A managed list of brand names, separate from Product.brand (a plain
// string) so a brand can be created ahead of any product using it, and
// deleted once nothing references it — deletion is blocked in the API
// while any Product still carries that name.
model Brand {
  id      String  @id @default(cuid())
  name    String  @unique
  logoUrl String?
}

// Managed list of garment types (hoodie, chaqueta, ...), same pattern as
// Brand: a name can be added ahead of any product using it, and deleted
// once no Product carries it.
model Category {
  id   String @id @default(cuid())
  name String @unique
}

// Stock belongs to a specific size+color combination, not the product as a
// whole — a shirt can be out of Black/M while Black/L and White/M are fine.
// color is null for products with no color options (sizes-only stock).
model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  size      String
  color     String?
  stock     Int     @default(0)

  @@unique([productId, size, color])
}

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

model Order {
  id                        String          @id @default(cuid())
  user                      User?           @relation(fields: [userId], references: [id])
  userId                    String?
  customerEmail             String
  customerName              String
  customerDocument          String?
  shippingAddress           String
  shippingAddressComplement String?
  shippingDepartment        String?
  shippingCity              String
  shippingPhone             String
  deliveryNotes             String?
  items                     OrderItem[]
  subtotalCents             Int
  discountCents             Int             @default(0)
  totalCents                Int
  couponCode                String?
  status                    OrderStatus     @default(PENDING)
  paymentMethod             PaymentMethod   @default(WOMPI)
  whatsappConfirmedAt       DateTime?
  // When the guía was last sent to the buyer over WhatsApp.
  whatsappTrackingSentAt    DateTime?
  wompiReference            String          @unique
  wompiTransactionId        String?
  carrier                   String          @default("Inter Rapidísimo")
  trackingNumber            String?
  shippedAt                 DateTime?
  deliveredAt               DateTime?
  /// Last state reported by the carrier's tracking (e.g. "En reparto").
  trackingStatus            String?
  trackingCheckedAt         DateTime?
  creditPayments            CreditPayment[]
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  size       String
  color      String?
  quantity   Int
  priceCents Int
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType
  value        Int
  active       Boolean      @default(true)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Proof of what a person accepted and when (Ley 1581 de 2012: the store
// must be able to show each data-processing authorization). One row per
// acceptance: checkout, WhatsApp order, newsletter or cookie choice.
// Created on first use by lib/consent.ts if it doesn't exist yet, so no
// manual migration is needed.
model ConsentRecord {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  // checkout | whatsapp_order | newsletter | cookies
  source          String
  email           String?
  name            String?
  phone           String?
  // Order reference when the acceptance came with an order.
  reference       String?
  acceptedTerms   Boolean  @default(false)
  acceptedPrivacy Boolean  @default(false)
  // Cookie banner choice: "all" or "necessary".
  cookies         String?
  // Version (date) of the legal texts that were shown.
  legalVersion    String
  ip              String?
  userAgent       String?

  @@index([email])
  @@index([createdAt])
}

// First-party, anonymous product analytics (only with cookie consent): one
// row per step a visit takes (page, product view, cart, checkout steps,
// purchase), to see where shoppers drop off. No name, email or IP.
// Created on first use by lib/analyticsServer.ts.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  sessionId String
  name      String
  path      String?
  productId String?
  step      Int?
  detail    String?
  value     Int?
  device    String?

  @@index([createdAt])
  @@index([sessionId])
}

/// Merchandise bought from a supplier. Its items can add units to the
/// store's inventory (and update the product's cost) when it's registered.
model Purchase {
  id            String         @id @default(cuid())
  date          DateTime
  supplier      String
  invoiceNumber String?
  /// Efectivo, Transferencia, Nequi, Daviplata, Tarjeta, Crédito, Otro.
  paymentMethod String
  /// Who paid it (the owner, a partner, the store's account…).
  paidBy        String?
  /// Bought for one specific sale (sold straight to the customer): its cost is that sale's cost.
  orderId       String?
  notes         String?
  totalCents    Int
  addedToStock  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]

  @@index([date])
  @@index([orderId])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId    String
  /// Store product it restocks; null for things that aren't inventory (bags, labels…).
  productId     String?
  description   String
  size          String?
  color         String?
  quantity      Int
  unitCostCents Int
}

/// Money in or out that isn't a store order or a merchandise purchase:
/// expenses (shipping, ads, packaging, fees, rent…), other income, owner
/// contributions and withdrawals.
model LedgerEntry {
  id          String   @id @default(cuid())
  date        DateTime
  /// INCOME or EXPENSE.
  type        String
  category    String
  description String
  amountCents Int
  method      String
  /// Who paid it (expense) or received it (income).
  paidBy      String?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([date])
}

/// An abono toward a fiado (an order with paymentMethod CREDIT).
model CreditPayment {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  date        DateTime
  amountCents Int
  method      String
  receivedBy  String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

/// People who pay or receive the store's money (partners, employees…),
/// offered in "¿Quién pagó?" / "¿Quién lo recibió?". Records keep the name
/// as text, so removing someone from the list never changes past entries.
model Partner {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  role      String?
  // The partner's own login to the panel (an ADMIN user), if they have one.
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
